{
  "manifest_version": 3,
  "name": "RecruitScout - Job Data Extractor",
  "version": "1.0.0",
  "description": "Extract job listing data from any job board website with a single click. Supports LinkedIn, Indeed, Glassdoor, and 20+ other platforms.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "offscreen",
    "alarms",
    "identity",
    "cookies"
  ],
  "oauth2": {
    "client_id": "115904503078-uo6086fg23p32frupfkqsgg6432nps2r.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.indeed.it/*",
    "*://*.indeed.co.uk/*",
    "*://*.trovolavoro.com/*",
