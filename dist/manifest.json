{
  "manifest_version": 3,
  "name": "RecruitScout - Job Data Extractor",
  "version": "1.0.0",
  "description": "Extract job listing data from any job board website with a single click. Supports LinkedIn, Indeed, Glassdoor, and 20+ other platforms.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.indeed.it/*",
    "*://*.indeed.co.uk/*",
    "*://*.trovolavoro.com/*",
    "*://*.trovolavoro.it/*",
    "https://www.glassdoor.com/*",
    "https://www.monster.com/*",
    "https://www.ziprecruiter.com/*",
    "https://www.careerbuilder.com/*",
    "https://www.simplyhired.com/*",
    "https://www.jobs.net/*",
    "https://www.jobrapido.com/*",
    "https://www.neuvoo.com/*",
    "https://www.snagajob.com/*",
    "https://www.dice.com/*",
    "https://www.guru.com/*",
    "https://www.upwork.com/*",
    "https://www.freelancer.com/*",
    "https://jobs.careers.microsoft.com/*",
    "https://careers.google.com/*",
    "https://careers.apple.com/*",
    "https://jobs.netflix.com/*",
    "https://www.amazon.jobs/*",
    "http://localhost:5173/*",
    "http://72.60.215.34/*",
    "https://next-api.useplunk.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "index.ts-loader.js"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.it/*",
        "*://*.indeed.co.uk/*",
        "*://*.trovolavoro.com/*",
        "*://*.trovolavoro.it/*",
        "https://www.glassdoor.com/*",
        "https://www.monster.com/*",
        "https://www.ziprecruiter.com/*",
        "https://www.careerbuilder.com/*",
        "https://www.simplyhired.com/*",
        "https://www.jobs.net/*",
        "https://www.jobrapido.com/*",
        "https://www.neuvoo.com/*",
        "https://www.snagajob.com/*",
        "https://www.dice.com/*",
        "https://www.guru.com/*",
        "https://www.upwork.com/*",
        "https://www.freelancer.com/*",
        "https://jobs.careers.microsoft.com/*",
        "https://careers.google.com/*",
        "https://careers.apple.com/*",
        "https://jobs.netflix.com/*",
        "https://www.amazon.jobs/*",
        "http://localhost:5173/*",
        "http://72.60.215.34/*"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "public/icons/*"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "*://*.indeed.co.uk/*",
        "*://*.indeed.com/*",
        "*://*.indeed.it/*",
        "*://*.trovolavoro.com/*",
        "*://*.trovolavoro.it/*",
        "http://72.60.215.34/*",
        "http://localhost:5173/*",
        "https://careers.apple.com/*",
        "https://careers.google.com/*",
        "https://jobs.careers.microsoft.com/*",
        "https://jobs.netflix.com/*",
        "https://www.amazon.jobs/*",
        "https://www.careerbuilder.com/*",
        "https://www.dice.com/*",
        "https://www.freelancer.com/*",
        "https://www.glassdoor.com/*",
        "https://www.guru.com/*",
        "https://www.jobrapido.com/*",
        "https://www.jobs.net/*",
        "https://www.linkedin.com/*",
        "https://www.monster.com/*",
        "https://www.neuvoo.com/*",
        "https://www.simplyhired.com/*",
        "https://www.snagajob.com/*",
        "https://www.upwork.com/*",
        "https://www.ziprecruiter.com/*"
      ],
      "resources": [
        "constants.js",
        "utils.js",
        "types.js",
        "index.ts.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "offscreen": {
    "document": "src/offscreen/index.html",
    "persistent": false
  },
  "options_page": "src/dashboard/index.html"
}
