    "https://www.guru.com/*",
    "https://www.upwork.com/*",
    "https://www.freelancer.com/*",
    "https://jobs.careers.microsoft.com/*",
    "https://careers.google.com/*",
    "https://careers.apple.com/*",
    "https://jobs.netflix.com/*",
    "https://amazon.jobs/*",
    "http://localhost:5173/*",
    "http://72.60.215.34/*",
    "http://72.60.215.34:8000/*",
    "https://supabase.72-60-215-34.sslip.io/*",
    "https://next-api.useplunk.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://autocomplete.clearbit.com/*",
    "https://qyceqgttvvairnaxwicm.supabase.co/*",
    "https://*.supabase.co/*",
    "https://www.wikidata.org/*",
    "https://html.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-C853U7xR.js"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.it/*",
        "*://*.indeed.co.uk/*",
        "*://*.trovolavoro.com/*",
        "*://*.trovolavoro.it/*",
        "https://www.glassdoor.com/*",
